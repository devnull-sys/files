Remove-Item -Path "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Compatibility Assistant\Store" -Recurse -Force *> $null
Remove-Item -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\FeatureUsage" -Recurse -Force *> $null
reg delete "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\TypedPaths" /f *> $null

